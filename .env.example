GOLDPRICE_DEV_API_KEY=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only key used to permanently delete users from Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Use the IPv4 transaction-pooler URL from Supabase Connect. Encode @ as %40 in passwords.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres
CAPACITOR_SERVER_URL=https://your-deployed-app.example.com
